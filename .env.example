# Database (docker-compose.yml reads POSTGRES_*; keep the password in sync with DATABASE_URL)
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=saimum_crm
# Host port for the Docker database. Use another one (e.g. 5433) if a Postgres is already
# installed on this machine and listening on 5432; then use the same port in DATABASE_URL.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://crm:change-me@localhost:5432/saimum_crm

# App
APP_URL=http://localhost:3000
AUTH_SECRET=generate-a-long-random-string
# 64 hex chars (32 bytes) for AES-256-GCM token encryption
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Meta App (shared by WhatsApp + Messenger)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
# Your own string; must match what you enter in the Meta webhook settings
META_WEBHOOK_VERIFY_TOKEN=
# Facebook Login for Business configuration id (WhatsApp Embedded Signup)
META_ES_CONFIG_ID=
# Connecting a REAL WhatsApp number (Coexistence) is a go-live step. Keep this false during
# development (use Meta's test number); set true on the production server only when going live.
ALLOW_REAL_CHANNEL_CONNECT=false
# Template broadcasts on a REAL (non-test) channel cost money and can get the number restricted
# if misused. Off by default; test channels can always broadcast to opted-in test contacts.
ALLOW_BROADCAST=false
# Hard cap on recipients of one broadcast.
BROADCAST_MAX_RECIPIENTS=1000

# WhatsApp test number (development only)
WA_TEST_PHONE_NUMBER_ID=
WA_TEST_WABA_ID=
WA_TEST_ACCESS_TOKEN=

# AI
AI_PROVIDER=anthropic   # or openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Office hours (Asia/Dhaka)
OFFICE_TZ=Asia/Dhaka
OFFICE_OPEN=10:00
OFFICE_CLOSE=22:00

# Where downloaded customer files (photos, voice notes...) are kept. Keep it on a persistent volume.
MEDIA_DIR=./.media
